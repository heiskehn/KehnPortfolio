{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth/login" },
    { "source": "/api/auth/verify", "destination": "/api/auth/verify" },
    { "source": "/api/projects/create", "destination": "/api/projects/create" },
    { "source": "/api/projects/:slug", "destination": "/api/projects/[slug]" },
    { "source": "/api/projects", "destination": "/api/projects/index" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
