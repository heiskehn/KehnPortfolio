# Copy this to .env.local for local development with "vercel dev"
# Add all of these to Vercel Dashboard → Project → Settings → Environment Variables

# ── Database (use PlanetScale / Railway / Aiven free tier) ──
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=portfolio_db
DB_SSL=true

# ── Auth ──
JWT_SECRET=change_this_to_a_long_random_string_32chars_min
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
